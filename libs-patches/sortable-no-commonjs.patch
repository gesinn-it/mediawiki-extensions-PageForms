Sortable: disable the CommonJS export.
In ResourceLoader "module" is defined, so the UMD wrapper would not create the global
Sortable object.

--- a/libs/Sortable.js
+++ b/libs/Sortable.js
@@ -5,7 +5,7 @@
  * @license MIT
  */
 (function (global, factory) {
-  typeof exports === 'object' && typeof module !== 'undefined' ? module.exports = factory() :
+  // Disabled for Page Forms: ResourceLoader defines "module", but Sortable has to be a global.
   typeof define === 'function' && define.amd ? define(factory) :
   (global = global || self, global.Sortable = factory());
 }(this, (function () { 'use strict';
