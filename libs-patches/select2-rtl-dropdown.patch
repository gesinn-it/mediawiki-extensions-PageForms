Select2: position the dropdown correctly on RTL pages.
Added in "Fix select2 open box position for RTL pages". Not fixed upstream in 4.1.0
(_positionDropdown has no RTL handling there).

--- a/libs/select2.js
+++ b/libs/select2.js
@@ -4528,7 +4528,10 @@
 
     css.top -= parentOffset.top;
     css.left -= parentOffset.left;
-
+    //fix for rtl forms
+    if( 'rtl' == $('html').attr('dir') ){
+      css.left += this.$element.next().width();
+    }
     if (!isCurrentlyAbove && !isCurrentlyBelow) {
       newDirection = 'below';
     }
